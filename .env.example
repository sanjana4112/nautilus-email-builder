# Copy this file to .env.local and fill in the values.

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Without a verified domain, Resend's test sender only delivers to your own account email.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Vercel Blob (image uploads): Vercel project > Storage > Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN=

# Temporal (scheduled sends). The local dev server runs here by default.
TEMPORAL_ADDRESS=localhost:7233
